pipeline {
    agent any
    
    tools {
        maven 'maven3'
    }

    stages {
        stage('checkout') {
            steps {
                echo 'Cloning GIT HUB Repo'
                git branch: 'main', url: 'https://github.com/harsha143-har/mindcircuit13.git'
            }
        }
        stage('sonar') {
            steps {
                sh 'ls -ltr'
                
                sh ''' mvn sonar:sonar \\
                      -Dsonar.host.url=http:\\13.222.0.203:9000 \\
                      -Dsonar.login=squ_750ccc0266aae215656af4664fb4b73aa1e1c037'''
            }
        }
        stage('Build Artifact') {
            steps {
                echo 'Build Artifact'
                sh 'mvn clean package'
            }
        }
        stage('Docker Image') {
            steps {
                echo 'Docker Image Building'
                sh 'docker build -t legen8d/batch13:${BUILD_NUMBER} .'
            }
        }
        stage('push to Dockerhub') {
            steps {
                script{
                    withCredentials([string(credentialsId: 'dockerhub', variable: 'dockerhub')]) 
                    {
                        sh 'docker login -u legen8d -p ${dockerhub}'
                    }
                    sh 'docker push legen8d/batch13:${BUILD_NUMBER}'
                }
              }
        }
        stage('Update Deployment File') {
		
		 environment {
            GIT_REPO_NAME = "mindcircuit13"
            GIT_USER_NAME = "harsha143-har"
        }
		
            steps {
                echo 'Update Deployment File'
				withCredentials([string(credentialsId: 'githubtoken', variable: 'githubtoken')]) 
				{
                  sh '''
                    git config user.email "harshachowdary006@gmail.com"
                    git config user.name "Harsha"
                    BUILD_NUMBER=${BUILD_NUMBER}
                    sed -i "s/batch13:.*/batch13:${BUILD_NUMBER}/g" deploymentfiles/deployment.yml
                    git add .
                    
                    git commit -m "Update deployment image to version ${BUILD_NUMBER}"

                    git push https://${githubtoken}@github.com/${GIT_USER_NAME}/${GIT_REPO_NAME} HEAD:main
                '''
				  
                 }
				
            }
        }
    }
}
